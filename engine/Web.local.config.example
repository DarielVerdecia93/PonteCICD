<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformação XDT aplicada ao Web.config publicado em cada deploy.
  Copie este ficheiro como Web.local.config e ajuste os valores do seu ambiente.
  O Web.local.config não está no repo do projeto: aqui vão as credenciais da BD administrada.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="BalcaoUnicoContext"
         connectionString="Data Source=SERVIDOR;Initial Catalog=BASE_DE_DADOS;User ID=UTILIZADOR;Password=PALAVRA_PASSE;Application Name=BalcaoUnico"
         xdt:Transform="SetAttributes(connectionString)" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="SiteURL" value="http://localhost:8090/"
         xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
