<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PonteCICD</RootNamespace>
    <AssemblyName>PonteCICD</AssemblyName>
    <ApplicationIcon>pontecicd.ico</ApplicationIcon>
    <Company>Magia Technologies Labs</Company>
    <Authors>Magia Technologies Labs</Authors>
    <Product>Ponte CI/CD</Product>
    <Copyright>Copyright (C) Magia Technologies Labs</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- App solo para Windows (DPAPI, servicio de Windows, IIS). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Copia el panel (wwwroot) junto al exe tambien en build/dotnet run, no solo en publish. -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
