@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject IDialogService Dialogs

<Tema />

<MudLayout>
    <MudAppBar Elevation="0" Class="barra">
        <img src="/icon.svg" alt="" width="24" height="24" class="mr-3" />
        <MudText Typo="Typo.h6" Class="mr-4 marca d-none d-sm-flex">Ponte CI/CD</MudText>
        @* Controlos da pagina aberta (ex.: «ao vivo», «Procurar alteracoes»). *@
        <SectionOutlet SectionName="barra" />
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2">
            @* No MudBlazor 9 o botao proprio tem de abrir o menu (context.ToggleAsync): sozinho nao passa o clique ao menu. *@
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ArrowDropDown" OnClick="@context.ToggleAsync">
                    <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-2">@Inicial</MudAvatar>
                    <span class="d-none d-sm-inline">@_user</span>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 pt-2 pb-3">
                    <MudText Typo="Typo.subtitle2">@_user</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Sessão iniciada</MudText>
                </div>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Key" OnClick="() => ProjectDialog.ShowAsync(Dialogs)">Acesso ao repositório</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.FilterAlt" OnClick="() => RulesDialog.ShowAsync(Dialogs)">Regras de publicação</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.Schedule" OnClick="() => SettingsDialog.ShowAsync(Dialogs)">Frequência de atualização</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Password" OnClick="() => PasswordDialog.ShowAsync(Dialogs)">Alterar palavra-passe</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.History" Href="/classico/">Painel antigo</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Outlined.Logout" IconColor="Color.Error" OnClick="LogoutAsync">Terminar sessão</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 pb-16">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] Task<AuthenticationState>? AuthState { get; set; }

    string _user = "";

    string Inicial => _user.Length > 0 ? _user[..1].ToUpperInvariant() : "?";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null) _user = (await AuthState).User.Identity?.Name ?? "";
    }

    Task LogoutAsync() => JS.InvokeVoidAsync("ponte.logout").AsTask();
}
