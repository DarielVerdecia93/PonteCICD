@inject IJSRuntime JS
@inject NavigationManager Nav

<MudDialog>
    <DialogContent>
        <EditForm Model="this" OnSubmit="SaveAsync">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_current" Label="Palavra-passe atual" InputType="InputType.Password"
                              Variant="Variant.Outlined" Immediate="true" AutoFocus="true" />
                <MudTextField @bind-Value="_next" Label="Nova palavra-passe" InputType="InputType.Password" Variant="Variant.Outlined"
                              Immediate="true" HelperText="@($"Mínimo {UserStore.MinPasswordLength} caracteres")" />
                <MudTextField @bind-Value="_again" Label="Repetir a nova palavra-passe" InputType="InputType.Password"
                              Variant="Variant.Outlined" Immediate="true" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
                }
                @* Enter num campo grava. *@
                <button type="submit" hidden></button>
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    string _current = "", _next = "", _again = "";
    string? _error;
    bool _busy;

    public static Task ShowAsync(IDialogService dialogs) =>
        dialogs.ShowAsync<PasswordDialog>("Alterar palavra-passe", new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

    // A API troca a palavra-passe e renova a cookie desta sessao (as outras terminam). A pagina recarrega para
    // continuar ja com a cookie nova: a ligacao aberta ainda tem a sessao antiga e seria terminada.
    async Task SaveAsync()
    {
        _error = null;
        if (_next != _again) { _error = "As novas palavras-passe não coincidem."; return; }
        _busy = true;
        try
        {
            var r = await JS.InvokeAsync<ApiReply>("ponte.send", "PUT", "/api/auth/password", new { current = _current, @new = _next });
            if (r.Ok)
            {
                Nav.NavigateTo("/?aviso=palavra-passe", forceLoad: true);
                return;
            }
            _error = r.Text;
        }
        finally
        {
            _busy = false;
        }
    }
}
